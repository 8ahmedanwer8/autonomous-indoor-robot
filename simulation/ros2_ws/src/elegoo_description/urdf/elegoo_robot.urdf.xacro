<?xml version="1.0"?>
<robot name="elegoo_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================================================= -->
  <!-- Stable Elegoo-style robot:
       - smaller blue box chassis
       - 4 visible black wheels
       - rear wheels are driven
       - front wheels are passive caster-like wheels
       - lidar is raised above camera/IMU
       - lidar frame fixed to lidar_link
       - smoother physics to reduce wheel shake
  -->
  <!-- ========================================================= -->

  <!-- ========================================================= -->
  <!-- Robot dimensions -->
  <!-- ========================================================= -->

  <xacro:property name="PI" value="3.14159265359"/>

  <!-- Chassis -->
  <xacro:property name="base_length" value="0.28"/>
  <xacro:property name="base_width"  value="0.18"/>
  <xacro:property name="base_height" value="0.07"/>
  <xacro:property name="base_mass"   value="1.8"/>

  <!-- Wheels -->
  <xacro:property name="wheel_radius" value="0.032"/>
  <xacro:property name="wheel_width"  value="0.022"/>
  <xacro:property name="wheel_mass"   value="0.12"/>

  <!-- Wheel positions -->
  <xacro:property name="front_wheel_x" value="0.085"/>
  <xacro:property name="rear_wheel_x"  value="-0.085"/>
  <xacro:property name="wheel_y"       value="0.105"/>

  <!-- Diff-drive wheel separation = distance between rear driven wheels -->
  <xacro:property name="wheel_separation" value="${2.0 * wheel_y}"/>

  <!-- base_footprint is on ground, base_link is at chassis center -->
  <xacro:property name="base_z"  value="${wheel_radius + base_height/2.0}"/>
  <xacro:property name="wheel_z" value="${wheel_radius - base_z}"/>

  <!-- Top of chassis relative to base_link -->
  <xacro:property name="top_z" value="${base_height/2.0}"/>

  <!-- Camera -->
  <xacro:property name="camera_length" value="0.045"/>
  <xacro:property name="camera_width"  value="0.030"/>
  <xacro:property name="camera_height" value="0.032"/>

  <!-- IMU -->
  <xacro:property name="imu_length" value="0.030"/>
  <xacro:property name="imu_width"  value="0.022"/>
  <xacro:property name="imu_height" value="0.008"/>

  <!-- LiDAR -->
  <xacro:property name="lidar_radius" value="0.032"/>
  <xacro:property name="lidar_height" value="0.030"/>
  <xacro:property name="lidar_mount_height" value="0.055"/>

  <!-- Sensor heights relative to base_link -->
  <xacro:property name="camera_z" value="${top_z + camera_height/2.0}"/>
  <xacro:property name="imu_z"    value="${top_z + imu_height/2.0}"/>

  <!-- ========================================================= -->
  <!-- Materials -->
  <!-- ========================================================= -->

  <material name="blue">
    <color rgba="0.05 0.22 0.95 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.01 0.01 0.01 1.0"/>
  </material>

  <material name="dark_gray">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>

  <material name="gray">
    <color rgba="0.45 0.45 0.45 1.0"/>
  </material>

  <material name="camera_black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>

  <!-- ========================================================= -->
  <!-- Inertia macros -->
  <!-- ========================================================= -->

  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="${(1.0/12.0) * m * (y*y + z*z)}"
        ixy="0"
        ixz="0"
        iyy="${(1.0/12.0) * m * (x*x + z*z)}"
        iyz="0"
        izz="${(1.0/12.0) * m * (x*x + y*y)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia_z" params="m r l">
    <!-- Cylinder axis is local Z -->
    <inertial>
      <mass value="${m}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="${(1.0/12.0) * m * (3.0*r*r + l*l)}"
        ixy="0"
        ixz="0"
        iyy="${(1.0/12.0) * m * (3.0*r*r + l*l)}"
        iyz="0"
        izz="${0.5 * m * r*r}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="wheel_inertia_y" params="m r l">
    <!-- Wheel spin axis is local Y -->
    <inertial>
      <mass value="${m}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="${(1.0/12.0) * m * (3.0*r*r + l*l)}"
        ixy="0"
        ixz="0"
        iyy="${0.5 * m * r*r}"
        iyz="0"
        izz="${(1.0/12.0) * m * (3.0*r*r + l*l)}"/>
    </inertial>
  </xacro:macro>

  <!-- ========================================================= -->
  <!-- Base footprint and chassis -->
  <!-- ========================================================= -->

  <link name="base_footprint"/>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>

    <xacro:box_inertia
      m="${base_mass}"
      x="${base_length}"
      y="${base_width}"
      z="${base_height}"/>
  </link>

  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
    <self_collide>false</self_collide>
  </gazebo>

  <!-- ========================================================= -->
  <!-- Rear driven wheel macro -->
  <!-- ========================================================= -->

  <xacro:macro name="rear_drive_wheel" params="name x y">
    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0" rpy="${PI/2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="${PI/2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>

      <xacro:wheel_inertia_y
        m="${wheel_mass}"
        r="${wheel_radius}"
        l="${wheel_width}"/>
    </link>

    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} ${wheel_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>

      <!-- Moderate damping reduces wheel jitter without locking the wheel -->
      <dynamics damping="0.10" friction="0.02"/>
    </joint>

    <gazebo reference="${name}_link">
      <material>Gazebo/Black</material>
      <self_collide>false</self_collide>

      <!-- Rear driven wheels: enough grip, not overly stiff -->
      <mu1>0.9</mu1>
      <mu2>0.7</mu2>
      <slip1>0.02</slip1>
      <slip2>0.08</slip2>
      <kp>60000.0</kp>
      <kd>6.0</kd>
    </gazebo>
  </xacro:macro>

  <!-- ========================================================= -->
  <!-- Front passive wheel macro -->
  <!-- Important:
       Visual looks like a wheel.
       Collision is a low-friction sphere.
       This makes the front act like caster wheels and stops them fighting turns.
  -->
  <!-- ========================================================= -->

  <xacro:macro name="front_passive_wheel" params="name x y">
    <link name="${name}_link">
      <!-- Visual wheel -->
      <visual>
        <origin xyz="0 0 0" rpy="${PI/2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black"/>
      </visual>

      <!-- Caster-like physics -->
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${wheel_radius}"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.03"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia
          ixx="0.00002"
          ixy="0"
          ixz="0"
          iyy="0.00002"
          iyz="0"
          izz="0.00002"/>
      </inertial>
    </link>

    <!-- Fixed joint is more stable than a passive continuous joint.
         The sphere collision gives caster-like motion. -->
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} ${wheel_z}" rpy="0 0 0"/>
    </joint>

    <gazebo reference="${name}_link">
      <material>Gazebo/Black</material>
      <self_collide>false</self_collide>

      <!-- Very low friction so the front wheels do not steer the robot -->
      <mu1>0.03</mu1>
      <mu2>0.03</mu2>
      <slip1>1.0</slip1>
      <slip2>1.0</slip2>
      <kp>30000.0</kp>
      <kd>3.0</kd>
    </gazebo>
  </xacro:macro>

  <!-- Front wheels: passive caster-like wheels -->
  <xacro:front_passive_wheel
    name="front_left_wheel"
    x="${front_wheel_x}"
    y="${wheel_y}"/>

  <xacro:front_passive_wheel
    name="front_right_wheel"
    x="${front_wheel_x}"
    y="-${wheel_y}"/>

  <!-- Rear wheels: driven wheels -->
  <xacro:rear_drive_wheel
    name="rear_left_wheel"
    x="${rear_wheel_x}"
    y="${wheel_y}"/>

  <xacro:rear_drive_wheel
    name="rear_right_wheel"
    x="${rear_wheel_x}"
    y="-${wheel_y}"/>

  <!-- ========================================================= -->
  <!-- LiDAR mount -->
  <!-- ========================================================= -->

  <link name="lidar_mount_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.035 0.035 ${lidar_mount_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.035 0.035 ${lidar_mount_height}"/>
      </geometry>
    </collision>

    <xacro:box_inertia
      m="0.03"
      x="0.035"
      y="0.035"
      z="${lidar_mount_height}"/>
  </link>

  <joint name="lidar_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_mount_link"/>
    <origin xyz="0.02 0 ${top_z + lidar_mount_height/2.0}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_mount_link">
    <material>Gazebo/Blue</material>
    <self_collide>false</self_collide>
  </gazebo>

  <!-- ========================================================= -->
  <!-- LiDAR link -->
  <!-- ========================================================= -->

  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>

    <xacro:cylinder_inertia_z
      m="0.06"
      r="${lidar_radius}"
      l="${lidar_height}"/>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="lidar_mount_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${lidar_mount_height/2.0 + lidar_height/2.0}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <material>Gazebo/Grey</material>
    <self_collide>false</self_collide>
  </gazebo>

  <!-- ========================================================= -->
  <!-- RGB-D camera link -->
  <!-- ========================================================= -->

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${camera_length} ${camera_width} ${camera_height}"/>
      </geometry>
      <material name="camera_black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${camera_length} ${camera_width} ${camera_height}"/>
      </geometry>
    </collision>

    <xacro:box_inertia
      m="0.07"
      x="${camera_length}"
      y="${camera_width}"
      z="${camera_height}"/>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.095 0 ${camera_z}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="camera_link">
    <material>Gazebo/Black</material>
    <self_collide>false</self_collide>
  </gazebo>

  <!-- Optical frame: ROS camera convention, z forward, x right, y down -->
  <link name="camera_optical_frame"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0.030 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- ========================================================= -->
  <!-- IMU link -->
  <!-- ========================================================= -->

  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${imu_length} ${imu_width} ${imu_height}"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${imu_length} ${imu_width} ${imu_height}"/>
      </geometry>
    </collision>

    <xacro:box_inertia
      m="0.025"
      x="${imu_length}"
      y="${imu_width}"
      z="${imu_height}"/>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.035 0 ${imu_z}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
    <material>Gazebo/DarkGrey</material>
    <self_collide>false</self_collide>
  </gazebo>

  <!-- ========================================================= -->
  <!-- Gazebo Sim 2-wheel differential drive plugin -->
  <!-- Only rear wheels are driven. Front wheels are passive. -->
  <!-- ========================================================= -->

  <gazebo>
    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">

      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>

      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>

      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>

      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>

      <odom_publish_frequency>50</odom_publish_frequency>

      <!-- Slow/smooth limits for cleaner odometry and SLAM -->
      <max_linear_velocity>0.90</max_linear_velocity>
      <min_linear_velocity>-0.45</min_linear_velocity>

      <max_angular_velocity>1.40</max_angular_velocity>
      <min_angular_velocity>-1.40</min_angular_velocity>

      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-2.0</min_linear_acceleration>

      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-4.0</min_angular_acceleration>

    </plugin>
  </gazebo>

  <!-- ========================================================= -->
  <!-- Gazebo LiDAR sensor -->
  <!-- Publishes Gazebo topic /scan -->
  <!-- Use /scan for slam_toolbox and Nav2 costmaps -->
  <!-- ========================================================= -->

  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <topic>/scan</topic>

      <!-- Critical: prevents scoped Gazebo frame like elegoo_robot/base_footprint/lidar_sensor -->
      <gz_frame_id>lidar_link</gz_frame_id>

      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-${PI}</min_angle>
            <max_angle>${PI}</max_angle>
          </horizontal>
        </scan>

        <range>
          <!-- Higher min range avoids scanning robot body -->
          <min>0.22</min>
          <max>6.0</max>
          <resolution>0.01</resolution>
        </range>

        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.0</stddev>
        </noise>
      </ray>
    </sensor>
  </gazebo>

  <!-- ========================================================= -->
  <!-- Gazebo RGB-D camera sensor -->
  <!-- Publishes Gazebo camera topics under /camera -->
  <!-- ========================================================= -->

  <gazebo reference="camera_link">
    <sensor name="rgbd_camera" type="rgbd_camera">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <topic>/camera</topic>

      <gz_frame_id>camera_optical_frame</gz_frame_id>

      <camera>
        <horizontal_fov>1.047</horizontal_fov>

        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>

        <clip>
          <near>0.25</near>
          <far>4.0</far>
        </clip>

        <noise type="gaussian">
          <mean>0.0</mean>
          <stddev>0.0</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

  <!-- ========================================================= -->
  <!-- Gazebo IMU sensor -->
  <!-- Publishes Gazebo topic /imu -->
  <!-- ========================================================= -->

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>/imu</topic>
      <visualize>true</visualize>

      <gz_frame_id>imu_link</gz_frame_id>

      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </x>

          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </y>

          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </z>
        </angular_velocity>

        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.017</stddev>
            </noise>
          </x>

          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.017</stddev>
            </noise>
          </y>

          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.017</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

</robot>
