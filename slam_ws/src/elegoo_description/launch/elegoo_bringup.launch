<launch>
  <!-- Robot description from xacro -->
  <param name="robot_description"
         command="$(find xacro)/xacro '$(find elegoo_description)/urdf/elegoo.urdf.xacro'" />

  <!-- Publish TF for all links/joints in URDF -->
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" />

  <!-- RPLidar node -->
  <node pkg="rplidar_ros" type="rplidarNode" name="rplidar">
    <param name="serial_port" value="/dev/ttyUSB0" />
    <param name="serial_baudrate" value="1000000" />
    <param name="frame_id" value="laser" />
  </node>

  <!-- Realsense driver -->
  <include file="$(find realsense2_camera)/launch/rs_camera.launch">
    <arg name="align_depth" value="true" />
    <arg name="enable_sync" value="true" />

    <arg name="color_width"  value="424" />
    <arg name="color_height" value="240" />
    <arg name="color_fps"    value="15" />

    <arg name="depth_width"  value="424" />
    <arg name="depth_height" value="240" />
    <arg name="depth_fps"    value="15" />

    <arg name="enable_pointcloud" value="false" />
    <arg name="enable_infra1" value="false" />
    <arg name="enable_infra2" value="false" />
  </include>



</launch>
