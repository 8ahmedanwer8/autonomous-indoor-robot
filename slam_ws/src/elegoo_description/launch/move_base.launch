<launch>
  <arg name="map_topic" default="/rtabmap/grid_map"/>

  <node pkg="move_base"
        type="move_base"
        name="move_base"
        output="screen">
    <rosparam file="$(find elegoo_description)/config/navigation/costmap_common.yaml"
              command="load"
              ns="global_costmap"/>
    <rosparam file="$(find elegoo_description)/config/navigation/costmap_common.yaml"
              command="load"
              ns="local_costmap"/>
    <rosparam file="$(find elegoo_description)/config/navigation/global_costmap.yaml"
              command="load"/>
    <rosparam file="$(find elegoo_description)/config/navigation/local_costmap.yaml"
              command="load"/>
    <rosparam file="$(find elegoo_description)/config/navigation/base_local_planner.yaml"
              command="load"/>
    <rosparam file="$(find elegoo_description)/config/navigation/move_base.yaml"
              command="load"/>

    <param name="global_costmap/static_layer/map_topic" value="$(arg map_topic)"/>
  </node>
</launch>

